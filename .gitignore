**/*.FCBak
*-backups/
mfg-bot/
*-bak
kibot.mak
kibot_error.log

# KiCad local history — per-developer scratch state, each its own git repo
.history/

# KiCad lock files — transient, machine/session-specific (hostname+username
# of whoever currently has the project open), never meant to be shared
*.lck

# Python bytecode cache (e.g. from check_schematic_drift.py)
__pycache__/
*.pyc
